<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.5</version>
        <relativePath />
    </parent>
    
    <groupId>org.glassfish.epicyro</groupId>
    <artifactId>parent</artifactId>
    <version>3.1.2</version>
    <packaging>pom</packaging>


    <name>Epicyro Parent</name>
    <description>
        Eclipse compatible implementation of Jakarta Authentication.
    </description>
    <url>https://projects.eclipse.org/projects/ee4j.epicyro</url>
    <inceptionYear>2023</inceptionYear>
    <licenses>
        <license>
            <name>EPL 2.0</name>
            <url>http://www.eclipse.org/legal/epl-2.0</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL2 w/ CPE</name>
            <url>https://www.gnu.org/software/classpath/license.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>arjan.tijms</id>
            <name>Arjan Tijms</name>
            <email>arjan.tijms@omnifish.ee</email>
        </developer>
        <developer>
            <id>jakarta-ee4j-epicyro</id>
            <name>Epicyro Developers</name>
            <organization>Eclipse Foundation</organization>
            <email>epicyro-dev@eclipse.org</email>
        </developer>
    </developers>
    <contributors>
       <contributor>
           <name>Epicyro Contributors</name>
           <email>epicyro-dev@eclipse.org</email>
           <url>https://github.com/eclipse-ee4j/epicyro/graphs/contributors</url>
       </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>Jakarta Authentication dev mailing list</name>
            <post>epicyro-dev@eclipse.org</post>
            <subscribe>https://dev.eclipse.org/mailman/listinfo/epicyro-dev</subscribe>
            <unsubscribe>https://dev.eclipse.org/mailman/listinfo/epicyro-dev</unsubscribe>
            <archive>https://dev.eclipse.org/mhonarc/lists/epicyro-dev</archive>
        </mailingList>
    </mailingLists>

    <scm>
        <url>scm:git:https://github.com/eclipse-ee4j/epicyro.git</url>
        <connection>scm:git:git://github.com/eclipse-ee4j/epicyro.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/eclipse-ee4j/epicyro.git</developerConnection>
    </scm>
    <issueManagement>
        <system>github</system>
        <url>https://github.com/eclipse-ee4j/epicyro/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Not published by the central-publishing-maven-plugin (comma separated artifactIds) -->
        <excludeArtifacts>epicyro-quarkus-test</excludeArtifacts>
    </properties>

    <modules>
        <module>impl</module>
        <module>spi</module>
    </modules>

    <build>
        <plugins>
            <!-- Sets minimal Maven version to 3.9.6 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.9.6</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate a "consumer pom" for the generated jar -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                </configuration>
                <executions>
                    <!-- enable flattening -->
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <!-- ensure proper cleanup -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
